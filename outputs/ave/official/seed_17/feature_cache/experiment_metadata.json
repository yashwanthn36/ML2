{
  "dataset_name": "ave",
  "dataset_adapter": "ave",
  "split_protocol": "official",
  "experiment_seed": 17,
  "training_conditions": [
    "reference",
    "ci_only",
    "proposed_ci_mi"
  ],
  "model_factory": "ave_mm.models:build_model",
  "encoders": {
    "encoder_1": {
      "modality": "modality_1",
      "name": "panns_cnn14",
      "kwargs": {
        "input_sample_rate": 16000,
        "pretrained": true,
        "freeze": true
      },
      "checkpoint_identity": "PANNs Cnn14_mAP=0.431 (AudioSet; official URL)",
      "checkpoint_sha256": null,
      "frozen": true,
      "preprocessing": {
        "input_sample_rate": 16000,
        "backbone_sample_rate": 32000,
        "backbone": "PANNs Cnn14 log-mel frontend"
      }
    },
    "encoder_2": {
      "modality": "modality_2",
      "name": "resnet18",
      "kwargs": {
        "pretrained": true,
        "freeze": true
      },
      "checkpoint_identity": "torchvision ResNet18_Weights.DEFAULT",
      "checkpoint_sha256": null,
      "frozen": true,
      "preprocessing": {
        "input": "RGB float frames in [0,1]",
        "resize": 224,
        "normalization": {
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      }
    }
  },
  "dataset_factory": "ave_mm.dataset:build_datasets",
  "dataset_preprocessing_config": {
    "manifest_path": "data/raw/AVE/ave/ave_manifest.csv",
    "root": ".",
    "num_frames": 8,
    "image_size": 224,
    "sample_rate": 16000,
    "audio_samples": 160000,
    "temporal_window_policy": "full_clip",
    "min_audio_coverage": 0.5
  },
  "test_preprocessing_config": {
    "manifest_path": "data/raw/AVE/ave/ave_manifest.csv",
    "root": ".",
    "num_frames": 8,
    "image_size": 224,
    "sample_rate": 16000,
    "audio_samples": 160000,
    "temporal_window_policy": "full_clip",
    "min_audio_coverage": 0.5
  },
  "feature_cache": {
    "enabled": false,
    "dataset_factory": "ave_mm.dataset:build_datasets"
  },
  "packages": {
    "torch": "2.11.0+cu128",
    "torchvision": "0.26.0+cu128",
    "torchaudio": "2.11.0+cu128",
    "numpy": "2.1.3",
    "opencv-python": "4.14.0.94",
    "scikit-learn": "1.6.1",
    "PyYAML": "6.0.2",
    "panns-inference": "0.1.1",
    "matplotlib": "3.11.2"
  },
  "python_version": "3.13.5 | packaged by Anaconda, Inc. | (main, Jun 12 2025, 16:37:03) [MSC v.1929 64 bit (AMD64)]",
